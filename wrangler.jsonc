{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "takoshin",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      // 自分自身を呼ぶための結び付け（OpenNext が使う）。名前は上の name と同じにする
      "binding": "WORKER_SELF_REFERENCE",
      "service": "takoshin",
    },
  ],
  // 独自ドメイン。DNS の記録と証明書は Cloudflare が自動で作る（daigakunote.com は Cloudflare で管理）。
  "routes": [{ "pattern": "takoshin.daigakunote.com", "custom_domain": true }],
  // workers.dev のアドレスもそのまま使う（送り済みの招待リンクのため）。
  // routes を書くと、wrangler は何も指定しなければ workers.dev を止めるので、はっきり true にする
  "workers_dev": true,
  // 1 日 1 回、期限切れ・削除の定時処理（日本時間 3:17）
  "triggers": { "crons": ["17 18 * * *"] },
  // 動作の記録（Workers Logs）。通信ごとの記録（invocation logs）は止める。通信ごとの記録には、見出しが丸ごと残り、
  // 管理用の鍵（X-Host-Key）・回答者の cookie・IP アドレスまで記録されてしまうため（プライバシーポリシー §1）。
  // console.log / console.error で書いた記録（定時処理の結果など）は残す
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  // データベースの近くで動かす（Smart Placement）。行き来の回数が多い処理ほど速くなる
  "placement": { "mode": "smart" },
  // PostgreSQL への接続の仲立ち（Hyperdrive）。公開のとき scripts/hyperdrive.mjs が
  // 次の行を本物の ID に書き換える。手元から公開するときは自分で書き換える（README を参照）
  // "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "<Hyperdrive の ID>" }]
}
