# 本番の PostgreSQL（Supabase などの接続文字列）。空なら .data/pglite に組み込みの PostgreSQL を作る（開発用）
DATABASE_URL=
# 公開しているアドレス（リンクの見出し画像の URL に使う）
NEXT_PUBLIC_SITE_URL=https://example.com
# 1 日 1 回の定時処理（/api/cron/cleanup）を呼ぶための合言葉。Cloudflare では Cron Trigger（worker.ts）がこれを付けて呼ぶ
CRON_SECRET=

# Cloudflare の手元確認（npm run cf:preview）では、同じ内容を .dev.vars に書く
# 運営者のページ（/admin）の合言葉。32 文字以上の乱数。空なら運営者のページには入れない
ADMIN_TOKEN=
